class Solution {
    ArrayList<Integer> arranged(ArrayList<Integer> arr) {
        // code here
        ArrayList<Integer>pos=new ArrayList<>();
        ArrayList<Integer>neg=new ArrayList<>();
        int ind=0;
       for(int num:arr){
           if(num>0){
               pos.add(num);
           }
           if(num<0){
               neg.add(num);
           }
       }
        ArrayList<Integer>res=new ArrayList<>();
        for(int i=0;i<pos.size();i++){
            res.add(pos.get(i));
            res.add(neg.get(i));
        }
        return res;
    }
}
